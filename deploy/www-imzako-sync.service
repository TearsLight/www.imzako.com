[Unit]
Description=Build and deploy www.imzako.com from origin/main
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/1panel/www/java/www.imzako.com
ExecStart=/opt/1panel/www/java/www.imzako.com/scripts/sync-main.sh
TimeoutStartSec=30min
Nice=10
