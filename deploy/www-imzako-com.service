[Unit]
Description=www.imzako.com Spring Boot service
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/1panel/www/java/www.imzako.com
ExecStart=/usr/bin/java -jar /opt/1panel/www/java/www.imzako.com/target/imzako-0.0.1-SNAPSHOT.jar --server.address=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
