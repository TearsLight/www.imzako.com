# =============================================================================
# 应用与域名
# =============================================================================
APP_NAME=imzako
APP_ENV=production
PUBLIC_DOMAIN=www.example.com
PUBLIC_URL=https://www.example.com
GIT_DOMAIN=git.example.com
BLOG_PUBLIC_URL=https://www.example.com/blog
BACKEND_URL=http://127.0.0.1:8080
FRONTEND_DEV_URL=http://localhost:5173
SERVER_PORT=8080
TRUST_PROXY=true

# =============================================================================
# RCON 管理端口（带令牌认证的 UTF-8 行协议）
# RCON_HOST：直接运行 JAR 用 127.0.0.1；Docker 发布端口时才用 0.0.0.0，
# 且宿主端只绑定 127.0.0.1:8090。
# =============================================================================
RCON_ENABLED=true
RCON_HOST=127.0.0.1
RCON_PORT=8090
# 必填：用 `openssl rand -hex 32` 生成随机令牌
RCON_TOKEN=CHANGE_ME

# =============================================================================
# Cookie 与会话
# 本地开发 COOKIE_DOMAIN 留空以生成仅限主机名的 Cookie；
# 启用 HTTPS 后把 COOKIE_SECURE 设为 true。
# =============================================================================
COOKIE_NAME=imzako_session
COOKIE_DOMAIN=
COOKIE_PATH=/
COOKIE_HTTP_ONLY=true
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax
# 必填：64 位随机十六进制（openssl rand -hex 32）
COOKIE_SECRET=CHANGE_ME
SESSION_TTL_SECONDS=604800

# =============================================================================
# 访问令牌与一次性令牌（秒）
# =============================================================================
TOKEN_ISSUER=www.example.com
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
# 必填：64 位随机十六进制（openssl rand -hex 32）
TOKEN_SECRET=CHANGE_ME

# =============================================================================
# MongoDB
# 需要认证时，可把凭据写入 MONGODB_URI，或分别提供
# MONGODB_USERNAME、MONGODB_PASSWORD、MONGODB_AUTH_SOURCE。
# =============================================================================
MONGODB_URI=mongodb://CHANGE_ME:CHANGE_ME@127.0.0.1:27017/imzako?authSource=admin
MONGODB_DATABASE=imzako
MONGODB_USERNAME=CHANGE_ME
MONGODB_PASSWORD=CHANGE_ME
MONGODB_AUTH_SOURCE=admin
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=10000

# =============================================================================
# CORS 跨域（逗号分隔的精确来源，末尾不带斜杠）
# =============================================================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,https://www.example.com,https://git.example.com
ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-CSRF-Token
ALLOW_CREDENTIALS=true

# =============================================================================
# 安全与防滥用
# =============================================================================
CSRF_ENABLED=true
PASSWORD_MIN_LENGTH=12
BCRYPT_COST=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# 邮件发送（BillionMail API）
# 生产走 BillionMail 发送 API，发件人 noreply@example.com；
# 只调用 BillionMail 的 API，不依赖 SMTP。
# =============================================================================
MAIL_TRANSPORT=billionmail
SENDER=noreply@example.com
SENDER_NAME=imzako
BILLIONMAIL_API_URL=https://webmail.example.com
# 必填：BillionMail 的专用发送 API 密钥
BILLIONMAIL_API_KEY=CHANGE_ME
BILLIONMAIL_TIMEOUT_MS=10000
# 可选：仅供 scripts/configure-billionmail.* 同步模板与发送 API 使用，运行时不需要。
BILLIONMAIL_API_TOKEN=CHANGE_ME

# =============================================================================
# 账号门禁
# 邮箱验证开启：注册后需确认邮件验证码才能登录；登录图形验证码保持关闭。
# =============================================================================
EMAIL_VERIFICATION_ENABLED=true
CAPTCHA_ENABLED=false
EMAIL_VERIFICATION_TTL_SECONDS=600
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_SENDS_PER_HOUR=5
LOGIN_CAPTCHA_THRESHOLD=3
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_FAILURE_MAX_TRACKED_KEYS=10000
REGISTRATION_MAX_REQUESTS_PER_HOUR=10
VERIFICATION_RESEND_MAX_REQUESTS_PER_HOUR=20
CAPTCHA_MAX_REQUESTS_PER_MINUTE=30
PUBLIC_RATE_LIMIT_MAX_TRACKED_KEYS=10000

# =============================================================================
# 浏览器可见的站点配置
# 只有 VITE_* 前缀的变量会暴露给前端代码，这里不要放密钥。
# VITE_EXTRA_SITES_JSON 接受含 name、label、description、address、href 字段的对象数组。
# =============================================================================
VITE_SITE_NAME=imzako
VITE_PUBLIC_DOMAIN=www.example.com
VITE_GIT_URL=https://git.example.com
VITE_BLOG_URL=https://www.example.com/blog
VITE_MAIL_URL=https://mail.example.com

# =============================================================================
# 博客
# Markdown 源目录，相对后端进程工作目录；容器部署建议改为持久化绝对路径。
# =============================================================================
BLOG_DIRECTORY=blog
VITE_BLOG_API_URL=/api/blog/posts
VITE_BLOG_POST_URL=/api/blog/post
VITE_BLOG_EVENTS_URL=/api/blog/events
VITE_LOGIN_ENDPOINT=/api/auth/login
VITE_REGISTER_ENDPOINT=/api/auth/register
VITE_HITOKOTO_API_URL=https://v1.hitokoto.cn/?encode=json&max_length=60
VITE_EXTRA_SITES_JSON=[]
